# ── AI Travel Assistant - Configuration ──────────────────────────────────────

# ── AI API KEY (use ONE of these) ─────────────────────────────────────────────

# OPTION 1: Gemini (FREE) - Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPTION 2: Claude/Anthropic - Get from https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NOTE: If GEMINI_API_KEY is set, it will be used. Otherwise Claude is used.

# ── Other Settings ─────────────────────────────────────────────────────────────

# OPTIONAL: Google Maps (for real distance calculation)
GOOGLE_MAPS_API=your_google_maps_key_here

# OPTIONAL: OpenWeather (for live weather)
OPENWEATHER_API_KEY=your_openweather_key_here

# JWT Secret (change this to any random string)
JWT_SECRET=travel_assistant_super_secret_key_2024

# App Settings
APP_PORT=8001
